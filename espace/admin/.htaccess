# Admin du site : toujours recharger la dernière version des pages et scripts.
# (Le .htaccess racine met le HTML en cache 1 h et les .js en cache 1 an.)
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
</IfModule>

# L'admin du site contient encore des scripts et des gestionnaires d'événements dans la page,
# une bibliothèque externe (JSZip) et des images de raw.githubusercontent.com :
# la politique de sécurité du dossier /espace/ ne lui est pas appliquée (même situation qu'à l'ancienne adresse /admin/).
<IfModule mod_headers.c>
  Header always unset Content-Security-Policy
</IfModule>
