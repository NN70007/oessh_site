# ====== Espace membres : en-têtes de sécurité (s'appliquent uniquement au dossier /espace/) ======
# Pour annuler en cas de problème : supprimer ce fichier.

<IfModule mod_headers.c>
  # Politique de sécurité du contenu : la page ne peut charger que ses propres fichiers,
  # les polices Google, le bouton de connexion Google et parler au script Google de l'espace.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src https://fonts.gstatic.com; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  # La page ne peut pas être affichée dans un cadre d'un autre site (anti-hameçonnage par superposition).
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Le bouton Google ouvre une fenêtre surgissante : il faut l'autoriser à communiquer avec la page.
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # Pas de mise en cache longue des scripts et styles de l'espace : chaque mise à jour est prise en compte tout de suite.
  <FilesMatch "\.(js|css|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
